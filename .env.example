# Supabase public configuration (safe for browser usage)
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key

# Server-only Supabase credential. Never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-server-key

# Optional local bootstrap authentication
LOCAL_ADMIN_EMAIL=admin@example.com
LOCAL_ADMIN_PASSWORD_HASH=replace-with-a-sha256-password-hash
LOCAL_AUTH_SECRET=replace-with-a-long-random-secret
